# FitBois 2.0 Environment Variables
# Copy this file to .env and update the values

# ============ TURSO DATABASE ============
# Get these from: https://turso.tech/app (free tier)
# For local development, leave these unset to use a local SQLite file.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# ============ FRONTEND (React) ============
# API URL for frontend to connect to backend
# For local development:
REACT_APP_API_URL=http://localhost:5000/api
# For production (Vercel handles this automatically via relative /api URL)

# ============ BACKEND (Express) ============
# Port for the backend server (local dev only)
PORT=5000

# Node environment
NODE_ENV=development
